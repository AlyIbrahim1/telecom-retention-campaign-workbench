# Copy this file to .env before starting the local pilot.
# Use sample or approved test data only. Never commit .env.

APP_ENV=local
AUTH_ENABLED=false

# Replace these development-only placeholders in your private .env file.
POSTGRES_DB=retention_workbench
POSTGRES_USER=retention_app
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql+psycopg://retention_app:replace-with-a-local-password@postgres:5432/retention_workbench
TEST_DATABASE_ADMIN_URL=postgresql://retention_app:replace-with-a-local-password@postgres:5432/postgres

CORS_ORIGIN=http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
MAX_REQUEST_BYTES=11000000
DATABASE_CONNECT_TIMEOUT_SECONDS=3
LOG_LEVEL=INFO

# Trusted  model startup validation. The artifact is mounted read-only.
MODEL_PATH=/workspace/models/random_forest_churn_bundle.joblib
MODEL_SHA256=e96bc451db7fd313cd34e549816afbedded45ff34665a2aafd70c63bf767b180

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
CHAT_TIMEOUT_SECONDS=20
CHAT_MAX_OUTPUT_TOKENS=600
CHAT_CONTEXT_MESSAGES=20
CHAT_CONFIRMATION_TTL_SECONDS=600
